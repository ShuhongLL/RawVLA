# Repository and data roots used by public scripts.
RAWVLA_ROOT=/path/to/RawVLA
DATA_ROOT=/path/to/rawvla-data

# Optional explicit interpreters.
PY=python
STARVLA_PYTHON=python
ROBOTWIN_PYTHON=python

# Optional model roots.
PRETRAINED_ROOT=/path/to/models
CKPT_ROOT=/path/to/checkpoints

# Optional proxy settings for dataset downloads. Leave empty for direct access.
PROXY_HTTP=
PROXY_ALL=
